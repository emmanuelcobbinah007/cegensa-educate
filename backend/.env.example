# Neon PostgreSQL connection string (from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/kasadb?sslmode=require"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Token expiry
JWT_EXPIRES_IN="8h"

# Server port
PORT=4000

# Allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
